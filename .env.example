# ─── Servidor ────────────────────────────────────────────────────────────
# Sin NEXT_PUBLIC_, a propósito: así no viajan al navegador.
# LGM_API_URL: la URL del Apps Script que termina en /exec
# LGM_SECRETO: copiar de Configuración del proyecto → Propiedades del script
LGM_API_URL=
LGM_SECRETO=

# ─── Navegador ───────────────────────────────────────────────────────────
NEXT_PUBLIC_GOTRACK_URL=https://gotrack-go.vercel.app

# Formularios de Google
# Cobranza: ID verificado el 23.08.2026.
# Cierre y Comprobante: URL PUBLICADA (/d/e/...), verificada el 24.08.2026 —
# necesaria para que el prefijado de ID de expediente (?entry.xxx=) funcione
# sin pasar por un redirect del dominio del editor.
NEXT_PUBLIC_LGM_FORM_COBRANZA=https://docs.google.com/forms/d/1R53_BzHljP5X7latpYPR73w0bb9tlK4TxE-AzeXtiz8/viewform
NEXT_PUBLIC_LGM_FORM_CIERRE=https://docs.google.com/forms/d/e/1FAIpQLSdTjvxEaIBf7IB39Qjf_btXx2dUxbAo1fUsU_fbgNFJ4KONGQ/viewform
NEXT_PUBLIC_LGM_FORM_COMPROBANTE=https://docs.google.com/forms/d/e/1FAIpQLSerQCSQgNC2Lq8HmU_jEPAiJzZ_pIELXcwQiHXyXvqFQeFWxw/viewform
